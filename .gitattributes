# Auto detect text files
* text=auto

# Ensure LF for Unix/macOS shell scripts and Python files
*.sh text eol=lf
*.command text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf

# Ensure CRLF for Windows batch and PowerShell scripts
*.bat text eol=crlf
*.ps1 text eol=crlf
